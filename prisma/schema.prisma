generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vulnerability {
  id               String        @id @default(uuid())
  cveId            String        @unique @map("cve_id")
  state            String        @default("published")
  description      Json          // {ko: String, en: String}
  publishedAt      DateTime?     @map("published_at")
  modifiedAt       DateTime?     @map("modified_at")
  sourceIdentifier String?       @map("source_identifier")
  references       Json          @default("[]")
  vulnStatus       String        @default("UndergoingAnalysis") @map("vuln_status")
  isKev            Boolean       @default(false) @map("is_kev")
  collectedAt      DateTime      @default(now()) @map("collected_at")

  // 대표 CVSS 점수 — 보유한 버전 중 최신 우선(v4.0 > v3.1 > v3.0 > v2).
  // 화면 배지·통계 차트·목록 필터가 모두 이 값을 기준으로 동작하도록 비정규화.
  primaryCvssVersion  String?  @map("primary_cvss_version")
  primarySeverity     String?  @map("primary_severity")
  primaryScore        Decimal? @map("primary_score")
  primaryAttackVector String?  @map("primary_attack_vector")

  cvssScores       CvssScore[]
  epssScore        EpssScore?
  cpeMappings      CpeMapping[]
  cweWeaknesses    CweWeakness[]
  kevEntry         KevEntry?
  kisaNotices      KisaNotice[]
  githubAdvisories GithubAdvisory[]
  aiSummary        AiSummary?
  exploitEntries   ExploitEntry[]

  @@index([publishedAt])
  @@index([modifiedAt])
  @@index([isKev])
  @@index([primarySeverity])
  @@index([primaryScore])
  @@map("vulnerability")
}

model CvssScore {
  id                    String    @id @default(uuid())
  vulnerabilityId       String    @map("vulnerability_id")
  version               String
  vectorString          String    @map("vector_string")
  baseScore             Decimal   @map("base_score")
  baseSeverity          String    @map("base_severity")
  exploitabilityScore   Decimal?  @map("exploitability_score")
  impactScore           Decimal?  @map("impact_score")
  attackVector          String?   @map("attack_vector")
  attackComplexity      String?   @map("attack_complexity")
  privilegesRequired    String?   @map("privileges_required")
  userInteraction       String?   @map("user_interaction")

  vulnerability         Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  @@unique([vulnerabilityId, version])
  @@index([baseSeverity])
  @@map("cvss_score")
}

model EpssScore {
  id            String    @id @default(uuid())
  vulnerabilityId String   @unique @map("vulnerability_id")
  score         Decimal
  percentile    Decimal
  collectedAt   DateTime  @default(now()) @map("collected_at")

  vulnerability Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  @@map("epss_score")
}

model CpeMapping {
  id             String    @id @default(uuid())
  vulnerabilityId String   @map("vulnerability_id")
  cpeUri         String    @map("cpe_uri")
  vendor         String
  product        String
  versionStart   String?   @map("version_start")
  versionEnd     String?   @map("version_end")
  isVulnerable   Boolean   @default(true) @map("is_vulnerable")

  vulnerability  Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  @@index([vulnerabilityId])
  @@map("cpe_mapping")
}

model CweWeakness {
  id              String    @id @default(uuid())
  vulnerabilityId String    @map("vulnerability_id")
  cweId           String    @map("cwe_id")
  name            String
  description     String?

  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  @@index([vulnerabilityId])
  @@map("cwe_weakness")
}

model KevEntry {
  id                 String    @id @default(uuid())
  vulnerabilityId    String    @unique @map("vulnerability_id")
  vendorProject      String    @map("vendor_project")
  product            String
  vulnerabilityName  String    @map("vulnerability_name")
  dateAdded          DateTime  @map("date_added")
  shortDescription   String?   @map("short_description")
  requiredAction     String?   @map("required_action")
  dueDate            DateTime? @map("due_date")
  knownRansomwareUse String?   @default("Unknown") @map("known_ransomware_use")
  cwes               String[]
  notes              String?

  vulnerability      Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  @@index([dateAdded])
  @@index([dueDate])
  @@map("kev_entry")
}

model KisaNotice {
  id              String    @id @default(uuid())
  vulnerabilityId String?   @map("vulnerability_id")
  guid            String    @unique
  title           String
  link            String
  description     String?
  pubDate         DateTime? @map("pub_date")
  source          String    @default("kisa")
  cveIds          String[]  @default([]) @map("cve_ids")
  collectedAt     DateTime  @default(now()) @map("collected_at")

  vulnerability   Vulnerability? @relation(fields: [vulnerabilityId], references: [id], onDelete: SetNull)

  @@index([vulnerabilityId])
  @@index([pubDate])
  @@map("kisa_notice")
}

model GithubAdvisory {
  id              String    @id @default(uuid())
  vulnerabilityId String?   @map("vulnerability_id")
  ghsaId          String    @unique @map("ghsa_id")
  cveId           String?   @map("cve_id")
  htmlUrl         String    @map("html_url")
  apiUrl          String    @map("api_url")
  summary         String
  description     String?
  severity        String?
  ecosystem       String?
  packageName     String?   @map("package_name")
  vulnerableRange String?   @map("vulnerable_range")
  patchedVersion  String?   @map("patched_version")
  cvssScore       Decimal?  @map("cvss_score")
  epssPercentage  Decimal?  @map("epss_percentage")
  cwes            String[]  @default([])
  publishedAt     DateTime? @map("published_at")
  updatedAt       DateTime? @map("updated_at")
  withdrawnAt     DateTime? @map("withdrawn_at")
  affectedPackages Json     @default("[]") @map("affected_packages")
  collectedAt     DateTime  @default(now()) @map("collected_at")

  vulnerability   Vulnerability? @relation(fields: [vulnerabilityId], references: [id], onDelete: SetNull)

  @@index([vulnerabilityId])
  @@index([cveId])
  @@index([ecosystem])
  @@index([severity])
  @@index([updatedAt])
  @@map("github_advisory")
}

model EolData {
  id            String   @id @default(uuid())
  product       String
  cycle         String
  codename      String?
  releaseDate   DateTime? @map("release_date")
  eolDate       DateTime? @map("eol_date")
  isEol         Boolean   @default(false) @map("is_eol")
  lts           Boolean   @default(false)
  supportStatus String    @default("Active") @map("support_status")
  category      String

  @@index([eolDate])
  @@index([isEol])
  @@index([category])
  @@map("eol_data")
}

model CollectionLog {
  id             String   @id @default(uuid())
  source         String
  startedAt      DateTime @map("started_at")
  completedAt    DateTime? @map("completed_at")
  status         String   @default("running")
  recordsFetched Int      @default(0) @map("records_fetched")
  recordsNew     Int      @default(0) @map("records_new")
  recordsUpdated Int      @default(0) @map("records_updated")
  error          String?

  @@map("collection_log")
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_config")
}

model ExploitEntry {
  id              String    @id @default(uuid())
  vulnerabilityId String    @map("vulnerability_id")
  xdbId           String    @map("xdb_id")
  xdbUrl          String    @map("xdb_url")
  exploitType     String?   @map("exploit_type")   // remote, local, dos 등
  dateAdded       DateTime? @map("date_added")
  cloneSshUrl     String?   @map("clone_ssh_url")
  source          String    @default("vulncheck-xdb") // 출처

  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  @@unique([vulnerabilityId, xdbId])
  @@map("exploit_entry")
}

model AiSummary {
  id            String    @id @default(uuid())
  vulnerabilityId String  @unique @map("vulnerability_id")
  summaryKo     String    @map("summary_ko")
  riskLevel     String    @default("중간") @map("risk_level")
  riskReason    String?   @map("risk_reason")
  recommendation String?
  generatedAt   DateTime  @default(now()) @map("generated_at")

  vulnerability Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  @@map("ai_summary")
}
